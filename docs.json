{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Gestione Sala",
  "description": "Documentazione di Gestione Sala: guida all'app per ristoranti e riferimento dell'API v1 (disponibilità, ospiti, prenotazioni, coda clienti).",
  "colors": {
    "primary": "#C34517",
    "light": "#FA6E1D",
    "dark": "#C34517"
  },
  "fonts": {
    "family": "Geist"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "https://gestionesala.com"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Accedi",
      "href": "https://app.gestionesala.com"
    }
  },
  "navigation": {
    "languages": [
      {
        "language": "it",
        "default": true,
        "tabs": [
          {
            "tab": "Guida",
            "icon": "book-open",
            "groups": [
              {
                "group": "Per iniziare",
                "pages": [
                  "index",
                  "guida/primi-passi",
                  "guida/glossario"
                ]
              },
              {
                "group": "Sezioni dell'app",
                "pages": [
                  "guida/home",
                  "guida/sala",
                  "guida/prenotazioni",
                  "guida/coda-clienti",
                  "guida/contatti",
                  "guida/automazioni",
                  "guida/consuntivo",
                  "guida/assistente-ia",
                  "guida/impostazioni"
                ]
              }
            ]
          },
          {
            "tab": "API",
            "icon": "code",
            "openapi": "openapi.yaml",
            "groups": [
              {
                "group": "Per iniziare",
                "pages": [
                  "api/introduzione",
                  "api/autenticazione",
                  "api/errori",
                  "api/idempotenza",
                  "api/limiti"
                ]
              },
              {
                "group": "Disponibilità",
                "icon": "calendar-check",
                "pages": [
                  "GET /availability"
                ]
              },
              {
                "group": "Ospiti",
                "icon": "user",
                "pages": [
                  "GET /guests/lookup"
                ]
              },
              {
                "group": "Prenotazioni",
                "icon": "calendar",
                "pages": [
                  "POST /reservations",
                  "PATCH /reservations/{id}",
                  "DELETE /reservations/{id}"
                ]
              },
              {
                "group": "Coda clienti",
                "icon": "list-ol",
                "pages": [
                  "POST /waitlist"
                ]
              },
              {
                "group": "Tutti gli endpoint",
                "icon": "file-lines",
                "pages": [
                  "api/riferimento-completo"
                ]
              }
            ]
          },
          {
            "tab": "IA e agenti",
            "icon": "robot",
            "groups": [
              {
                "group": "IA e agenti",
                "pages": [
                  "ia/panoramica",
                  "ia/prompt-agenti"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python"
      ]
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "add-mcp",
      "cursor",
      "vscode",
      "download-spec"
    ]
  },
  "seo": {
    "metatags": {
      "og:image": "/og-image.png"
    }
  },
  "search": {
    "prompt": "Cerca nella documentazione"
  },
  "markdown": {
    "instructions": "Documentazione di Gestione Sala. Il testo completo, incluso il riferimento API, è in https://docs.gestionesala.com/llms-full.txt. Per endpoint, campi e codici di errore la fonte di verità è openapi.yaml: non usare endpoint o campi non documentati."
  }
}
